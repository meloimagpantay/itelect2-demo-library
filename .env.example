# .env.example -- every variable this project reads, no real values.
# Copy it to .env on your laptop and fill it in.
# .env itself is never committed.

# --- your laptop: NODE_ENV is not set, so config.cjs uses development
PORT=3000
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=itelect2_library_dev
DB_HOST=localhost

# Generate your own -- do not copy this line as-is.
# The server refuses to start if it is under 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste_your_own_64_character_hex_string_here

# Session 12. Web pages allowed to call this API from a browser,
# separated by commas. Leave it empty to allow none.
CORS_ORIGIN=http://localhost:5173

# --- Render only: set on the service's Environment page, not here
# DATABASE_URL   the database's Internal Database URL
# JWT_SECRET     a NEW secret, not the one from your laptop
# CORS_ORIGIN    the address of the front end, if there is one
# Render sets PORT and NODE_ENV=production itself. Do not add them.
